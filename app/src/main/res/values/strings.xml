    <!-- Permissions Screen -->
    <string name="perm_title">Required Field Permissions</string>
    <string name="perm_subtitle">MeshGuard operates completely offline without internet or cellular connectivity. These hardware permissions allow your phone to form local mesh radios.</string>
    <string name="perm_bt_title">Bluetooth LE Discovery &amp; Advertising</string>
    <string name="perm_bt_desc">Enables local peer discovery and hop-by-hop gossip packet broadcast to nearby phones.</string>
    <string name="perm_wifi_title">Nearby Wi-Fi Direct Devices</string>
    <string name="perm_wifi_desc">High-throughput peer data transfers without connecting to a router or Wi-Fi hotspot.</string>
    <string name="perm_location_title">Location (Android 8–11 only)</string>
    <string name="perm_location_desc">Required by legacy Android versions to perform Bluetooth scans. MeshGuard does NOT track your GPS coordinates.</string>
    <string name="perm_audio_title">Microphone Access</string>
    <string name="perm_audio_desc">Allows recording short 15-second emergency voice drop blackbox memos into the mesh.</string>
    <string name="perm_notif_title">Triage &amp; Relay Alerts</string>
    <string name="perm_notif_desc">Alerts you when a rescuer acknowledges your beacon or when urgent relay packets are received.</string>
    <string name="perm_grant_all">Grant Permissions</string>

    <!-- Onboarding Screen -->
    <string name="onboarding_slide1_title">Grid Down. You Are Not Alone.</string>
    <string name="onboarding_slide1_desc">When cell towers fail, MeshGuard connects directly to nearby smartphones via Bluetooth and Wi-Fi Direct.</string>
    <string name="onboarding_slide2_title">Every Device is a Data Mule.</string>
    <string name="onboarding_slide2_desc">Distress signals and messages hop phone-to-phone through the crowd until they reach first responders.</string>
    <string name="onboarding_slide3_title">Zero Internet. Zero Tracking.</string>
    <string name="onboarding_slide3_desc">Built purely for disaster resilience. No tracking, minimal battery draw, and encrypted survivor medical IDs.</string>

